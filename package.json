{
  "name": "nexsales",
  "version": "0.3.0",
  "private": true,
  "description": "NexSales — Smart Sales Management Platform. PDV, gestão de produtos, clientes e relatórios.",
  "author": "OTM Tech",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "desktop": "electron .",
    "desktop:build": "npm rebuild better-sqlite3 && next build && node scripts/copy-standalone.mjs && electron-builder --win",
    "desktop:rebuild-sqlite": "npx electron-rebuild -f -w better-sqlite3",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dexie": "^4.4.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "br.com.otmtech.nexsales",
    "productName": "NexSales",
    "directories": {
      "output": "instalador"
    },
    "artifactName": "NexSales-Instalador.${ext}",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NexSales"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MatheusBrazolin",
        "repo": "NexSales"
      }
    ]
  }
}
